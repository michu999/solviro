---
interface Props {
  title: string;
  description: string;
  breadcrumb: { label: string; href: string }[];
}

const { title, description, breadcrumb } = Astro.props;
---

<section 
  class="relative min-h-[240px] sm:min-h-[280px] flex items-end pb-8 sm:pb-12 lg:pb-16" 
  style="background-color: var(--color-bg-subtle);"
>
  <!-- Decorative accent -->
  <div 
    class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-24 sm:h-32 hidden lg:block" 
    style="background-color: var(--color-cta-bg); margin-left: max(2rem, calc((100vw - 1280px) / 2));"
    aria-hidden="true"
  ></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl lg:pl-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm mb-4" aria-label="Ścieżka nawigacji">
        <ol class="flex items-center gap-2" style="color: var(--color-text-muted);">
          {breadcrumb.map((item, index) => (
            <li class="flex items-center gap-2">
              {index > 0 && <span aria-hidden="true">/</span>}
              {index === breadcrumb.length - 1 ? (
                <span style="color: var(--color-text);" aria-current="page">{item.label}</span>
              ) : (
                <a href={item.href} class="hover:underline transition-colors duration-200">
                  {item.label}
                </a>
              )}
            </li>
          ))}
        </ol>
      </nav>

      <!-- Headline -->
      <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight mb-3 sm:mb-4" style="color: var(--color-text);">
        {title}
      </h1>

      <!-- Description -->
      <p class="text-base sm:text-lg lg:text-xl leading-relaxed max-w-2xl" style="color: var(--color-text-muted);">
        {description}
      </p>
    </div>
  </div>

  <!-- Decorative geometric element -->
  <div class="absolute right-4 sm:right-8 bottom-4 sm:bottom-8 w-20 h-20 sm:w-24 sm:h-24 lg:w-32 lg:h-32 opacity-10 hidden md:block" aria-hidden="true">
    <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="50" cy="50" r="45" stroke="currentColor" stroke-width="2" style="color: var(--color-accent);" />
      <circle cx="50" cy="50" r="30" stroke="currentColor" stroke-width="2" style="color: var(--color-accent);" />
      <circle cx="50" cy="50" r="15" stroke="currentColor" stroke-width="2" style="color: var(--color-accent);" />
    </svg>
  </div>
</section>

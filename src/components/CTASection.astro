---
interface Props {
  variant?: 'dark' | 'light';
}

const { variant = 'dark' } = Astro.props;
const isDark = variant === 'dark';
---

<section 
  class="py-16 sm:py-20 lg:py-24" 
  style={isDark ? 'background-color: var(--color-primary);' : 'background-color: var(--color-bg-subtle);'}
  aria-labelledby="cta-heading"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center">
      <h2
        id="cta-heading"
        class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold mb-4 sm:mb-6"
        style={isDark ? 'color: var(--color-bg);' : 'color: var(--color-text);'}
      >
        Nie wiesz od czego zacząć?
      </h2>
      <p
        class="text-base sm:text-lg leading-relaxed mb-6 sm:mb-8"
        style={isDark ? 'color: rgba(255,255,255,0.75);' : 'color: var(--color-text-muted);'}
      >
        Umów się na bezpłatną 15-minutową konsultację. Przeanalizujemy Twoją sytuację i zaproponujemy najlepsze rozwiązanie.
      </p>
      <a
        href="/kontakt#formularz"
        class="cta-button text-base sm:text-lg"
      >
        Umów bezpłatną konsultację
      </a>
    </div>
  </div>
</section>

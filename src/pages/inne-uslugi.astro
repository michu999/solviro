---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout title="Inne usługi — Solviro Legal" description="Kompleksowe usługi prawne w zakresie prawa gospodarczego, doradztwa biznesowego i obsługi przedsiębiorstw.">

  <PageHero
    title="Inne usługi"
    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Oferujemy kompleksowe wsparcie prawne dla przedsiębiorstw."
    breadcrumb={[
      { label: 'Strona główna', href: '/' },
      { label: 'Inne usługi', href: '/inne-uslugi' }
    ]}
  />

  <!-- Services Overview -->
  <section class="py-20 sm:py-28" style="background-color: var(--color-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="inline-block font-semibold text-sm uppercase tracking-wider mb-4" style="color: var(--color-accent);">Nasze usługi</span>
        <h2 class="font-heading text-3xl sm:text-4xl font-bold mb-6" style="color: var(--color-text);">
          Kompleksowa obsługa prawna
        </h2>
        <p class="text-lg leading-relaxed" style="color: var(--color-text-muted);">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Service Card 1 -->
        <div class="p-8 rounded-lg" style="background-color: var(--color-bg-subtle);">
          <div class="w-14 h-14 rounded-md flex items-center justify-center mb-6" style="background-color: var(--color-cta-bg);">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-cta-text);">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="font-heading text-xl font-bold mb-4" style="color: var(--color-text);">Prawo gospodarcze</h3>
          <p class="leading-relaxed" style="color: var(--color-text-muted);">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore.
          </p>
        </div>

        <!-- Service Card 2 -->
        <div class="p-8 rounded-lg" style="background-color: var(--color-bg-subtle);">
          <div class="w-14 h-14 rounded-md flex items-center justify-center mb-6" style="background-color: var(--color-cta-bg);">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-cta-text);">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="font-heading text-xl font-bold mb-4" style="color: var(--color-text);">Doradztwo biznesowe</h3>

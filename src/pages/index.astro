            </svg>
          </div>
          <span class="absolute top-6 sm:top-8 right-6 sm:right-8 font-heading text-5xl sm:text-6xl font-bold opacity-10" style="color: var(--color-text);">01</span>
          <h3 class="font-heading text-lg sm:text-xl font-bold mb-4" style="color: var(--color-text);">Bezpłatna konsultacja</h3>

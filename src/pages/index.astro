              <div class="w-11 sm:w-12 h-11 sm:h-12 rounded-md flex items-center justify-center flex-shrink-0" style="background-color: rgba(201,176,55,0.1);">
                <svg class="w-5 sm:w-6 h-5 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-accent);" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="text-sm mb-1" style="color: rgba(255,255,255,0.5);">Napisz do nas</p>
                <a href="mailto:kontakt@solviro.pl" class="font-semibold transition-colors duration-300" style="color: var(--color-accent);">
                  kontakt@solviro.pl
                </a>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="w-11 sm:w-12 h-11 sm:h-12 rounded-md flex items-center justify-center flex-shrink-0" style="background-color: rgba(201,176,55,0.1);">
                <svg class="w-5 sm:w-6 h-5 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-accent);" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="text-sm mb-1" style="color: rgba(255,255,255,0.5);">Odwiedź nas</p>
                <p class="font-semibold" style="color: var(--color-accent);">
                  ul. Przykładowa 123, 00-001 Warszawa
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column - Form -->
        <div class="p-6 sm:p-8 lg:p-10 rounded-lg" style="background-color: var(--color-bg);">
          <h2 class="font-heading text-xl sm:text-2xl font-bold mb-6" style="color: var(--color-text);">
            Jak możemy Ci pomóc?
          </h2>
          
          <form id="homepage-contact-form" class="space-y-5" novalidate>
            <!-- Service Selector -->
            <fieldset>
              <legend class="sr-only">Wybierz rodzaj usługi</legend>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <button type="button" class="service-card" data-service="restrukturyzacja">
                  Restrukturyzacja
                </button>
                <button type="button" class="service-card" data-service="upadlosc">
                  Upadłość
                </button>
                <button type="button" class="service-card" data-service="inne">
                  Inne usługi
                </button>
              </div>
            </fieldset>
            <input type="hidden" name="service" id="homepage-service-input" value="" />

            <div>
              <label for="homepage-email" class="sr-only">Adres e-mail</label>
              <input
                type="email"
                id="homepage-email"
                name="email"
                required
                autocomplete="email"
                class="w-full"
                placeholder="Adres e-mail"
              />
            </div>

            <div>
              <label for="homepage-phone" class="sr-only">Numer telefonu</label>
              <input
                type="tel"
                id="homepage-phone"
                name="phone"
                required
                autocomplete="tel"
                class="w-full"
                placeholder="Numer telefonu"
              />
            </div>

            <!-- GDPR Checkbox -->
            <div class="space-y-2">
              <div class="flex items-start gap-3">
                <input
                  type="checkbox"
                  id="homepage-gdpr"
                  name="gdpr"
                  required
                  class="mt-0.5 flex-shrink-0"
                />
                <label for="homepage-gdpr" class="text-sm cursor-pointer leading-snug" style="color: var(--color-text-muted);">
                  Wyrażam zgodę na przetwarzanie moich danych osobowych *
                  <button type="button" id="homepage-gdpr-toggle" class="underline ml-1" style="color: var(--color-accent);">rozwiń</button>
                </label>
              </div>
              <div id="homepage-gdpr-full-text" class="hidden text-xs pl-8 leading-relaxed" style="color: var(--color-text-muted);">
                Wyrażam zgodę na przetwarzanie moich danych osobowych przez Solviro Legal z siedzibą w Polsce, w celu odpowiedzi na przesłane zapytanie, zgodnie z Rozporządzeniem Parlamentu Europejskiego i Rady (UE) 2016/679 (RODO). Podanie danych jest dobrowolne, jednak niezbędne do udzielenia odpowiedzi. Przysługuje Pani/Panu prawo dostępu do danych, ich sprostowania, usunięcia lub ograniczenia przetwarzania.
              </div>
              <p id="homepage-gdpr-error" class="hidden text-sm pl-8" style="color: var(--color-error);" role="alert">
                Zgoda na przetwarzanie danych jest wymagana
              </p>
            </div>

            <button
              type="submit"
              id="homepage-contact-submit"
              class="w-full cta-button"
            >
              <span id="homepage-submit-text">Umów bezpłatną konsultację</span>
            </button>

            <p class="text-sm text-center" style="color: var(--color-text-muted);">
              Oddzwonimy w ciągu 24 godzin
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  const serviceCards = document.querySelectorAll('#homepage-contact-form .service-card');
  const serviceInput = document.getElementById('homepage-service-input') as HTMLInputElement | null;

  serviceCards.forEach(card => {
    card.addEventListener('click', () => {
      serviceCards.forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      if (serviceInput) {
        serviceInput.value = (card as HTMLElement).dataset.service || '';
      }
    });
  });

  // GDPR toggle
  const gdprToggle = document.getElementById('homepage-gdpr-toggle');
  const gdprFullText = document.getElementById('homepage-gdpr-full-text');

  gdprToggle?.addEventListener('click', () => {
    const isHidden = gdprFullText?.classList.contains('hidden');
    gdprFullText?.classList.toggle('hidden');
    if (gdprToggle) {
      gdprToggle.textContent = isHidden ? 'zwiń' : 'rozwiń';
    }
  });

  const form = document.getElementById('homepage-contact-form') as HTMLFormElement | null;
  const gdprCheckbox = document.getElementById('homepage-gdpr') as HTMLInputElement | null;
  const gdprError = document.getElementById('homepage-gdpr-error');
  const submitBtn = document.getElementById('homepage-contact-submit') as HTMLButtonElement | null;
  const submitText = document.getElementById('homepage-submit-text');

  let isSubmitting = false;

  function setLoading(loading: boolean) {
    isSubmitting = loading;
    if (submitBtn) {
      submitBtn.disabled = loading;
    }
    submitText?.classList.toggle('opacity-50', loading);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (isSubmitting) return;

    // Validate GDPR checkbox
    if (!gdprCheckbox?.checked) {
      gdprError?.classList.remove('hidden');
      gdprCheckbox?.focus();
      return;
    }
    gdprError?.classList.add('hidden');

    setLoading(true);

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      
      if (response.ok) {
        form.reset();
        serviceCards.forEach(c => c.classList.remove('selected'));
        alert('Dziękujemy! Skontaktujemy się wkrótce.');
      } else {
        throw new Error('Request failed');
      }
    } catch (err) {
      alert('Wystąpił błąd. Spróbuj ponownie później.');
    } finally {
      setLoading(false);
    }
  });
</script>

          <div class="w-14 sm:w-16 h-14 sm:h-16 rounded-md flex items-center justify-center mb-6" style="background-color: var(--color-cta-bg);">
            <svg class="w-7 sm:w-8 h-7 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-cta-text);" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
            </svg>
          </div>
          <span class="absolute top-6 sm:top-8 right-6 sm:right-8 font-heading text-5xl sm:text-6xl font-bold opacity-10" style="color: var(--color-text);">02</span>
          <h3 class="font-heading text-lg sm:text-xl font-bold mb-4" style="color: var(--color-text);">Analiza i strategia</h3>

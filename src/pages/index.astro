                </svg>
                <span>Upadłość konsumencka</span>
              </li>
              <li class="flex items-center gap-3" style="color: var(--color-text);">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-accent);" aria-hidden="true">

          <div class="relative z-10">
            <div class="w-12 sm:w-14 h-12 sm:h-14 rounded-md flex items-center justify-center mb-6 sm:mb-8" style="background-color: var(--color-cta-bg);">
              <svg class="w-6 sm:w-7 h-6 sm:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-cta-text);" aria-hidden="true">

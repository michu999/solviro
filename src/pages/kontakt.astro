---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout title="Kontakt — Solviro Legal" description="Skontaktuj się z nami. Umów bezpłatną konsultację w sprawie restrukturyzacji lub upadłości.">
  
  <PageHero
    title="Skontaktuj się z nami"
    description="Pierwsza konsultacja jest bezpłatna. Umów się na rozmowę i dowiedz się, jak możemy pomóc."
    breadcrumb={[
      { label: 'Strona główna', href: '/' },
      { label: 'Kontakt', href: '/kontakt' }
    ]}
  />

  <!-- Contact Section -->
  <section id="formularz" class="py-16 sm:py-20 lg:py-24" style="background-color: var(--color-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <!-- Left Column - Contact Info -->
        <div>
          <h2 class="font-heading text-2xl sm:text-3xl font-bold mb-6 sm:mb-8" style="color: var(--color-text);">
            Dane kontaktowe
          </h2>

          <address class="not-italic space-y-6 sm:space-y-8">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-md flex items-center justify-center flex-shrink-0" style="background-color: var(--color-bg-subtle);">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-accent);" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-heading text-lg font-semibold mb-2" style="color: var(--color-text);">Adres</h3>
                <p style="color: var(--color-text-muted);">
                  ul. Przykładowa 123<br />
                  00-001 Warszawa
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-md flex items-center justify-center flex-shrink-0" style="background-color: var(--color-bg-subtle);">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-accent);" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h3 class="font-heading text-lg font-semibold mb-2" style="color: var(--color-text);">Telefon</h3>
                <a href="tel:+48123456789" class="transition-colors duration-200 hover:underline" style="color: var(--color-text-muted);">
                  +48 123 456 789
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-md flex items-center justify-center flex-shrink-0" style="background-color: var(--color-bg-subtle);">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-accent);" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="font-heading text-lg font-semibold mb-2" style="color: var(--color-text);">E-mail</h3>
                <a href="mailto:kontakt@solviro.pl" class="transition-colors duration-200 hover:underline" style="color: var(--color-text-muted);">
                  kontakt@solviro.pl
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-md flex items-center justify-center flex-shrink-0" style="background-color: var(--color-bg-subtle);">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-accent);" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-heading text-lg font-semibold mb-2" style="color: var(--color-text);">Godziny pracy</h3>
                <p style="color: var(--color-text-muted);">
                  Poniedziałek – Piątek: 9:00 – 17:00<br />
                  Sobota – Niedziela: Zamknięte
                </p>
              </div>
            </div>
          </address>
        </div>

        <!-- Right Column - Form -->
        <div class="p-6 sm:p-8 lg:p-10 rounded-lg" style="background-color: var(--color-bg-subtle);">
          <h2 class="font-heading text-xl sm:text-2xl font-bold mb-6" style="color: var(--color-text);">
            Jak możemy Ci pomóc?
          </h2>
          
          <form id="contact-form" class="space-y-5" novalidate>
            <!-- Service Selector -->
            <fieldset>
              <legend class="sr-only">Wybierz rodzaj usługi</legend>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <button type="button" class="service-card" data-service="restrukturyzacja">
                  Restrukturyzacja
                </button>
                <button type="button" class="service-card" data-service="upadlosc">
                  Upadłość
                </button>
                <button type="button" class="service-card" data-service="inne">
                  Inne usługi
                </button>
              </div>
            </fieldset>
            <input type="hidden" name="service" id="service-input" value="" />

            <div>
              <label for="email" class="sr-only">Adres e-mail</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="w-full"
                placeholder="Adres e-mail"
              />
            </div>

            <div>
              <label for="phone" class="sr-only">Numer telefonu</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                autocomplete="tel"
                class="w-full"
                placeholder="Numer telefonu"
              />
            </div>

            <!-- GDPR Checkbox -->
            <div class="space-y-2">
              <div class="flex items-start gap-3">
                <input
                  type="checkbox"
                  id="gdpr"
                  name="gdpr"
                  required
                  class="mt-0.5 flex-shrink-0"
                />
                <label for="gdpr" class="text-sm cursor-pointer leading-snug" style="color: var(--color-text-muted);">
                  Wyrażam zgodę na przetwarzanie moich danych osobowych *
                  <button type="button" id="gdpr-toggle" class="underline ml-1" style="color: var(--color-accent);">rozwiń</button>
                </label>
              </div>
              <div id="gdpr-full-text" class="hidden text-xs pl-8 leading-relaxed" style="color: var(--color-text-muted);">
                Wyrażam zgodę na przetwarzanie moich danych osobowych przez Solviro Legal z siedzibą w Polsce, w celu odpowiedzi na przesłane zapytanie, zgodnie z Rozporządzeniem Parlamentu Europejskiego i Rady (UE) 2016/679 (RODO). Podanie danych jest dobrowolne, jednak niezbędne do udzielenia odpowiedzi. Przysługuje Pani/Panu prawo dostępu do danych, ich sprostowania, usunięcia lub ograniczenia przetwarzania.
              </div>
              <p id="gdpr-error" class="hidden text-sm pl-8" style="color: var(--color-error);" role="alert">
                Zgoda na przetwarzanie danych jest wymagana
              </p>
            </div>

            <button
              type="submit"
              class="w-full cta-button"
              id="contact-submit"
            >
              <span id="contact-submit-text">Umów bezpłatną konsultację</span>
            </button>

            <p class="text-sm text-center" style="color: var(--color-text-muted);">
              Oddzwonimy w ciągu 24 godzin
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <CTASection variant="dark" />

</Layout>

<script>
  const serviceCards = document.querySelectorAll('#contact-form .service-card');
  const serviceInput = document.getElementById('service-input') as HTMLInputElement | null;

  serviceCards.forEach(card => {
    card.addEventListener('click', () => {
      serviceCards.forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      if (serviceInput) {
        serviceInput.value = (card as HTMLElement).dataset.service || '';
      }
    });
  });

  // GDPR toggle
  const gdprToggle = document.getElementById('gdpr-toggle');
  const gdprFullText = document.getElementById('gdpr-full-text');

  gdprToggle?.addEventListener('click', () => {
    const isHidden = gdprFullText?.classList.contains('hidden');
    gdprFullText?.classList.toggle('hidden');
    if (gdprToggle) {
      gdprToggle.textContent = isHidden ? 'zwiń' : 'rozwiń';
    }
  });

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const gdprCheckbox = document.getElementById('gdpr') as HTMLInputElement | null;
  const gdprError = document.getElementById('gdpr-error');
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const submitText = document.getElementById('contact-submit-text');
  const spinner = document.getElementById('contact-spinner');

  let isSubmitting = false;

  function setLoading(loading: boolean) {
    isSubmitting = loading;
    if (submitBtn) {
      submitBtn.disabled = loading;
    }
    submitText?.classList.toggle('opacity-50', loading);
    spinner?.classList.toggle('hidden', !loading);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (isSubmitting) return;

    // Validate GDPR checkbox
    if (!gdprCheckbox?.checked) {
      gdprError?.classList.remove('hidden');
      gdprCheckbox?.focus();
      return;
    }
    gdprError?.classList.add('hidden');

    setLoading(true);

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      
      if (response.ok) {
        form.reset();
        serviceCards.forEach(c => c.classList.remove('selected'));
        alert('Dziękujemy! Skontaktujemy się wkrótce.');
      } else {
        throw new Error('Request failed');
      }
    } catch (err) {
      alert('Wystąpił błąd. Spróbuj ponownie później.');
    } finally {
      setLoading(false);
    }
  });
</script>
